# Required server-side database access. Do not add NEXT_PUBLIC_ to the secret key.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_replace-with-complete-key"

# Both providers are required for independent draft review.
GEMINI_API_KEY="replace-with-gemini-key"
GROQ_API_KEY="replace-with-groq-key"

# Optional model overrides. Use models enabled for your account.
# GEMINI_MODEL="gemini-2.5-flash"
# GROQ_MODEL="llama-3.3-70b-versatile"

# Optional: source file for npm run migrate:supabase only.
# DATABASE_URL="file:../curriculumos.db"
