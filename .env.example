# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
# SQLite (no Docker needed — for hackathon demo):
DATABASE_URL=sqlite+aiosqlite:///./curriculumos.db
# Vercel: set DATABASE_URL in project settings to a persistent PostgreSQL URL
# such as Supabase's Session pooler URL (port 5432, sslmode=require).
# The Supabase project URL and publishable key cannot substitute for this URL.
# PostgreSQL (requires Docker — for production):
# DATABASE_URL=postgresql+asyncpg://curriculumos:curriculumos@localhost:5432/curriculumos
CELERY_BROKER_URL=redis://localhost:6379/0
ENVIRONMENT=development

# --- LLM providers (see config/providers.yaml for routing/priority) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
# Hugging Face Inference Providers; token needs inference permission.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507:nscale
HF_VERIFY_MODEL=meta-llama/Llama-3.1-8B-Instruct:nscale
# Ollama is local — no key, just point at a running instance if not localhost.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional: override the model(s) Ollama uses. Generation and verification
# default to the same model (llama3.3) if unset — set these to two
# different models if Ollama is your only working LLM provider, so
# verification isn't a model grading its own output.
OLLAMA_MODEL=
OLLAMA_VERIFY_MODEL=

# --- Embedding provider ---
# Only needed once an embedding provider is wired in app/providers/embeddings/.
EMBEDDING_PROVIDER_API_KEY=

# --- Parsing ---
# Docling runs locally (no key required). Only set these if a managed
# OCR fallback (e.g. LlamaParse) is wired in.
OCR_FALLBACK_API_KEY=
